# MySpace Secure Vault Configuration
# -------------------------------------------------------------
# Optional secret used to derive cryptographic keys for server-side AES-256-GCM encryption.
# In production / Vercel deployment, configure a strong, random 64-character secret.
VAULT_SECRET="your-secure-production-vault-crypto-secret-key-256"

# Optional custom backend URL if frontend and API backend are hosted on separate domains.
# Leave empty or omit when deploying fullstack to Vercel or running locally.
VITE_API_URL=""

# Port for local development server (defaults to 3000)
PORT=3000

# GEMINI_API_KEY: Optional key for server-side AI features.
GEMINI_API_KEY=""

# APP_URL: The public base URL where this application is hosted.
APP_URL="http://localhost:3000"
